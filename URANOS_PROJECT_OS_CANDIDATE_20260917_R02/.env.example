# =============================================================================
# URANOS Project OS — Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in real values.
#   cp .env.example .env
#
# .env is git-ignored. NEVER commit .env with real secrets.
# =============================================================================

# ── MariaDB ──────────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=change_me_root_password
DB_FRAPPE_PASSWORD=change_me_frappe_password

# ── Frappe Site ───────────────────────────────────────────────────────────────
FRAPPE_SITE_NAME=uranos.localhost
ADMIN_PASSWORD=change_me_admin_password

# ── Redis ─────────────────────────────────────────────────────────────────────
# Redis cache max-memory (adjust for your host RAM)
REDIS_CACHE_MAXMEM=256mb
